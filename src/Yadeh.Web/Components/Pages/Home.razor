@page "/"
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using Yadeh.Application.SharedChats.Contracts
@using Yadeh.Application.SharedChats.Models
@using Yadeh.Domain.SharedChats
@inject IChatGptSharedChatProbeClient ProbeClient

<PageTitle>Yadeh</PageTitle>

<main>
    <h1>Yadeh</h1>
    <p>Paste a shared ChatGPT conversation link.</p>

    <EditForm Model="_form" OnValidSubmit="ProbeAsync" FormName="share-link">
        <DataAnnotationsValidator />

        <label for="shareUrl">Shared conversation link</label>

        <InputText id="shareUrl" class="form-control" type="url" placeholder="https://chatgpt.com/share/..."
                   @bind-Value="_form.Url" />

        <ValidationMessage For="@(() => _form.Url)" />

        <button type="submit" disabled="@_isLoading">
            @(_isLoading ? "Checking..." : "Check link")
        </button>
    </EditForm>

    @if (_validationError is not null)
    {
        <p role="alert">@_validationError</p>
    }

    @if (_result is { IsSuccess: false })
    {
        <p role="alert">@_result.Error</p>
    }

    @if (_result?.Snapshot is { } snapshot)
    {
        <section>
            <h2>@(snapshot.Title ?? "Untitled conversation")</h2>

            <p>
                @snapshot.Messages.Count messages ·
                @_result.DownloadedContentLength characters downloaded
            </p>

            @foreach (var message in snapshot.Messages)
            {
                <article @key="message.Sequence">
                    <h3>@message.Role</h3>
                    <pre>@message.Content</pre>
                </article>
            }
        </section>
    }
</main>

@code {
    private readonly ImportForm _form = new();
    private readonly CancellationTokenSource _disposeTokenSource = new();

    private SharedChatProbeResult? _result;
    private string? _validationError;
    private bool _isLoading;

    private async Task ProbeAsync()
    {
        _result = null;
        _validationError = null;

        if (!ChatGptSharedChatLink.TryCreate(
                _form.Url,
                out var link))
        {
            _validationError =
                "Enter a valid https://chatgpt.com/share/... link.";

            return;
        }

        _isLoading = true;

        try
        {
            _result = await ProbeClient.ProbeAsync(
                link,
                _disposeTokenSource.Token);
        }
        catch (OperationCanceledException)
            when (_disposeTokenSource.IsCancellationRequested)
        {
            // The component was disposed while the request was running.
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        _disposeTokenSource.Cancel();
        _disposeTokenSource.Dispose();
    }

    private sealed class ImportForm
    {
        [Required(ErrorMessage = "Enter a shared conversation link.")]
        [Url(ErrorMessage = "Enter a valid URL.")]
        public string Url { get; set; } = string.Empty;
    }
}